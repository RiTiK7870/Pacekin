# Copy this file to .env and fill in your values.
# EXPO_PUBLIC_ values are bundled into the app. Never put secret keys in them.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Public legal pages (host the files in the legal folder; see legal/README.md)
EXPO_PUBLIC_PRIVACY_URL=https://YOUR-SITE/privacy.html
EXPO_PUBLIC_TERMS_URL=https://YOUR-SITE/terms.html
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://YOUR-SITE/delete-account.html

# Server-only. Send to Supabase with:
#   npx supabase secrets set "OPENROUTER_API_KEY=<value from your .env>"
OPENROUTER_API_KEY=sk-or-your-key-here
